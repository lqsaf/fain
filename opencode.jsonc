{
  "$schema": "https://opencode.ai/config.json",

  // FA — автономный агент. Модели выбирает scripts/fa/models.mjs;
  // здесь только провайдеры, MCP-инструменты и жёсткие границы.
  "default_agent": "fa",
  "model": "google/gemini-3.1-flash-lite",

  // FA работает без человека: контекст сжимается, вывод инструментов ограничен.
  "compaction": {
    "auto": true,
    "keep": { "tokens": 12000 },
    "buffer": "10%"
  },
  "tool_output": {
    "max_lines": 1200,
    "max_bytes": 60000
  },
  "watcher": {
    "ignore": ["fa/logs/**", "fa/state/**", "fa/eval/**", "fa/memory/**", "fa/tmp/**", "node_modules/**", ".wrangler/**"]
  },
  "experimental": {
    "todo": true,
    "subagent_depth": 1
  },

  // V2: providers (не provider), package (не npm), settings (не options).
  // Ключи приходят только из env; в файле их нет.
  "providers": {
    "google": {
      "env": ["GEMINI_API_KEY", "GEMINI_API_KEY_2", "GEMINI_API_KEY_3", "GEMINI_API_KEY_4", "GEMINI_API_KEY_5", "GOOGLE_GENERATIVE_AI_API_KEY", "GOOGLE_API_KEY"],
      "settings": {
        "apiKey": "{env:GEMINI_API_KEY}",
        "headerTimeout": 300000,
        "chunkTimeout": 300000
      }
    },
    "xerosharc": {
      "name": "XEROSHARC gateway",
      "env": ["XEROSHARC_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://xerosharc.site/v1",
        "apiKey": "{env:XEROSHARC_API_KEY}",
        "headerTimeout": 300000,
        "chunkTimeout": 300000
      },
      "models": {
        "claude-haiku-5-5": {
          "name": "Claude Haiku 5.5 (XEROSHARC)",
          "limit": { "context": 1000000, "output": 128000 }
        },
        "claude-sonnet-5-5": {
          "name": "Claude Sonnet 5.5 (XEROSHARC)",
          "limit": { "context": 1000000, "output": 128000 }
        },
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5 (XEROSHARC)",
          "limit": { "context": 1000000, "output": 128000 }
        },
        "gpt-5.5": {
          "name": "GPT-5.5 (XEROSHARC)",
          "limit": { "context": 400000, "output": 128000 }
        },
        "gpt-5.5-pro": {
          "name": "GPT-5.5 Pro (XEROSHARC)",
          "limit": { "context": 400000, "output": 128000 }
        }
      }
    },
    "nvidia": {
      "name": "NVIDIA NIM",
      "env": ["NVIDIA_API_KEY", "NVIDIA_NIM_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      },
      "models": {
        "nemotron-3-ultra-550b-a55b": {
          "name": "Nemotron 3 Ultra 550B A55B",
          "modelID": "nvidia/nemotron-3-ultra-550b-a55b",
          "limit": { "context": 1000000, "output": 8192 }
        }
      }
    }
  },
  "openrouter": {
    "name": "OpenRouter",
    "env": ["OPENROUTER_API_KEY"],
    "package": "@opencode/ai/providers/openai-compatible",
    "settings": {
      "baseURL": "https://openrouter.ai/api/v1",
      "apiKey": "{env:OPENROUTER_API_KEY}",
      "headerTimeout": 300000,
      "chunkTimeout": 300000
    },
    "models": {
      "baidu/ernie-5.5-flash-preview:free": {
        "name": "ERNIE 5.5 Flash Preview (free)",
        "limit": { "context": 256000, "output": 32000 }
      }
    }
  },

  // MCP даёт модели детерминированные инструменты: очередь, verify, diff,
  // контекст, память. Это дешевле, чем читать весь репозиторий в контекст.
  "mcp": {
    "timeout": {
      "startup": 15000,
      "catalog": 15000,
      "execution": 180000
    },
    "servers": {
      "fa": {
        "type": "local",
        "command": ["node", "scripts/fa/mcp-server.mjs"],
        "cwd": ".",
        "codemode": false,
        "environment": {
          "FA_MCP": "1"
        }
      }
    }
  },

  // Базовые правила для человека. Агенты добавляют свои запреты в .opencode/agents.
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },

    // Секреты не читаются и не редактируются.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": ".dev.vars*", "effect": "deny" },
    { "action": "read", "resource": "$HOME/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "$HOME/.aws/*", "effect": "deny" },
    { "action": "read", "resource": "$HOME/.config/gh/*", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": ".dev.vars*", "effect": "deny" },

    // Необратимое и разрушительное — только человек, вручную.
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "su *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "rm -r *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean -fdx*", "effect": "deny" },
    { "action": "shell", "resource": "wrangler deploy*", "effect": "deny" },
    { "action": "shell", "resource": "npm publish*", "effect": "deny" },
    { "action": "shell", "resource": "npm install *", "effect": "deny" },
    { "action": "shell", "resource": "pnpm *", "effect": "deny" },
    { "action": "shell", "resource": "yarn *", "effect": "deny" },
    { "action": "shell", "resource": "bun add *", "effect": "deny" }
  ],

  // Жёсткие запреты: сохранённые approval не могут их отменить.
  "policies": [
    { "action": "tool.use", "resource": "shell:git push --force*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push -f*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git reset --hard*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git clean -fdx*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm -rf *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sudo *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:wrangler deploy*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:npm publish*", "effect": "deny" }
  ]
}
