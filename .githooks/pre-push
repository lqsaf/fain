#!/usr/bin/env bash
# Блокирует прямой push в main/master. Merge — только через PR.
# Включается один раз: git config core.hooksPath .githooks
set -euo pipefail

blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "${remote_ref:-}" in
    refs/heads/main | refs/heads/master)
      echo "FA: direct push to ${remote_ref#refs/heads/} is blocked. Open a PR instead." >&2
      blocked=1
      ;;
  esac
done

if [ "$blocked" -ne 0 ]; then
  exit 1
fi
